# Database Configuration
# DB_HOST=localhost when running the API on your machine (npm run start:dev).
# docker-compose.yml overrides DB_HOST to "db" for the api service.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT Configuration (RS256 — asymmetric)
# Generate dev keys: openssl genrsa -out keys/jwt-private.pem 2048 && openssl rsa -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_EXPIRES_IN=15m
# Days a refresh token stays valid. A user idle longer than this must sign in again.
REFRESH_TOKEN_EXPIRES_DAYS=1

# Application
# NODE_ENV must be one of: development | production | test.
# The app refuses to start if it, or any DB_HOST/DB_USER/DB_PASSWORD/DB_NAME, is missing.
# DB_PORT, SALT_ROUNDS and REFRESH_TOKEN_EXPIRES_DAYS must be positive integers when set.
NODE_ENV=development
PORT=
# CORS allowlist: the browser origin(s) of the web app, comma-separated, e.g.
# https://app.example.org,https://staging.example.org
# Each entry is scheme://host[:port] with no path, trailing slash or wildcard.
# Required when NODE_ENV=production; in development it defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Initial admin (npm run db:seed) — only created if email does not exist yet
ADMIN_EMAIL=
# Quote passwords containing $ so Docker Compose does not treat $ as variable interpolation

# Must meet the signup rule: 8-20 characters with upper, lower, digit and special character.
ADMIN_PASSWORD=

# Bcrypt Configuration
SALT_ROUNDS=12